# ─── Backend ───────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diabetes_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diabetes_db_test

# ─── Frontend ──────────────────────────────────────────────
# API base URL (set to HPC backend URL in production)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# ─── Sensor APIs (Phase 5: w21-25) ────────────────────────
# Dexcom API credentials
# DEXCOM_CLIENT_ID=
# DEXCOM_CLIENT_SECRET=
# DEXCOM_REDIRECT_URI=

# Libre API credentials
# LIBRE_API_KEY=
# LIBRE_API_SECRET=

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
